  "grammar": [
    {
      "pattern": "ここ／そこ／あそこ／どこ",
      "meaning": "Ở đây / ở đó / ở kia / ở đâu. Dạng lịch sự: こちら／そちら／あちら／どちら",
      "examples": [
        {
          "jp": "きょう は どこ で たべますか。",
          "meaning": "Hôm nay ăn ở đâu?",
          "blank": "どこ",
          "choices": [
            "どこ",
            "なに",
            "だれ",
            "いつ"
          ],
          "chunks": [
            "きょう",
            "は",
            "どこ",
            "で",
            "たべますか。"
          ]
        }
      ]
    },
    {
      "pattern": "N が Adjな です → Adj じゃないです",
      "meaning": "Tính từ đuôi な: bỏ な trước です. Phủ định: じゃないです／じゃありません",
      "examples": [
        {
          "jp": "いい人 が 好きです。",
          "meaning": "Tôi thích người tốt.",
          "chunks": [
            "いい人",
            "が",
            "好きです。"
          ]
        },
        {
          "jp": "わるい人 が 好きじゃないです。",
          "meaning": "Tôi không thích người xấu.",
          "chunks": [
            "わるい人",
            "が",
            "好きじゃないです。"
          ]
        }
      ]
    },
    {
      "pattern": "N が Adjい です → Adjくないです",
      "meaning": "Phủ định tính từ đuôi い: bỏ い, thêm くないです. Đặc biệt: いい → よくないです",
      "examples": [
        {
          "jp": "たかくないです。",
          "meaning": "Không đắt."
        },
        {
          "jp": "はやくないです。",
          "meaning": "Không nhanh."
        },
        {
          "jp": "よくないです。",
          "meaning": "Không tốt."
        }
      ]
    },
    {
      "pattern": "Địa điểm で N を Vます",
      "meaning": "Làm (V) ở (địa điểm)",
      "examples": [
